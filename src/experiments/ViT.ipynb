   "source": [
    "all_attrs = [trained_attrs]\n",
    "sims = []\n",
    "mean_sims = []\n",
    "\n",
    "for i in reversed(range(12)):\n",
    "    for name, param in vit_model.vit.encoder.layer[i].named_parameters():\n",
    "        if param.requires_grad:\n",
    "            param.data = torch.randn_like(param)\n",
    "\n",
    "    _, _, rand_attrs = evaluateViT(vit_model, imgs_list, labels_list, engine=lrp_engine, run_lrp=True)\n",
    "\n",
    "    all_attrs.append(rand_attrs)\n",
    "\n",
    "    sim = np.array([ corr(h0, hrand) for h0, hrand in zip(trained_attrs, rand_attrs) ])\n",
    "\n",
    "    sims.append(sim)\n",
    "    mean_sims.append(mean_sim := sim.mean())\n",
    "    print(mean_sim)"
   ]
  },
